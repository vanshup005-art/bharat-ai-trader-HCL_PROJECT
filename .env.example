# =================================================================
# BharatAI Trader - Environment Configuration Template
# Copy this file to '.env' and populate your API credentials if desired.
# Note: The platform operates with the Built-in Quantitative Engine
# if no API keys are provided (100% offline & zero-key).
# =================================================================

# Google Gemini API Key (for Gemini 2.5 Flash, Gemini 2.5 Pro)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (for GPT-4o, GPT-4o-mini, o1-mini)
# Obtain from: https://platform.openai.com/
OPENAI_API_KEY=

# Application Environment Mode (development / production)
APP_ENV=development
